+# ─── Email — Resend (recommandé) ou SMTP ───────────────────────────────────────
+# OBLIGATOIRE : sans RESEND_API_KEY ni SMTP_HOST / SMTP_USER, aucun code de confirmation
+# n'est envoyé et les nouveaux comptes ne peuvent pas s'activer (en NODE_ENV=development,
+# le code est alors écrit dans les logs pour pouvoir tester).
+#
+# Resend (https://resend.com) : renseigner RESEND_API_KEY suffit, le SMTP est alors ignoré.
+#  1. resend.com → Domains → Add domain, ajouter les enregistrements DNS (SPF, DKIM)
+#     chez le registrar et attendre le statut « Verified ».
+#  2. API Keys → Create API key, permission « Sending access » limitée à ce domaine.
+#  3. MAIL_FROM doit utiliser le domaine vérifié (ex. noreply@votre-domaine.com).
+#     Sans domaine vérifié, seul onboarding@resend.dev fonctionne, et uniquement
+#     vers l'adresse du compte Resend (tests).
+RESEND_API_KEY=
+# Adresse de réponse facultative (ex. contact@votre-domaine.com)
+MAIL_REPLY_TO=
+#
+# SMTP (alternative, utilisé seulement si RESEND_API_KEY est vide)
 SMTP_HOST=
 SMTP_PORT=587
 SMTP_SECURE=false
