+/**
+ * Transport Resend (API HTTP) : choisi dès que RESEND_API_KEY est renseignée, à la
+ * place du SMTP. Passe par HTTPS (443), donc fonctionne aussi chez les hébergeurs
+ * qui bloquent les ports SMTP sortants. Même interface que nodemailer (`sendMail`)
+ * et mêmes propriétés d'erreur (`code`, `responseCode`) pour la logique de réessai.
+ */
+const RESEND_URL = 'https://api.resend.com/emails';
+
+const resendConfigure = () => {
+  const cle = String(process.env.RESEND_API_KEY || '').trim();
+  return Boolean(cle) && !/A_RENSEIGNER|^your_/i.test(cle);
+};
+
+const resendTransporter = {
+  sendMail: async ({ from, to, subject, html, text }) => {
+    let reponse;
+    try {
+      reponse = await fetch(RESEND_URL, {
+        method: 'POST',
+        headers: {
+          Authorization: `Bearer ${process.env.RESEND_API_KEY.trim()}`,
+          'Content-Type': 'application/json',
+        },
+        body: JSON.stringify({
+          from,
+          to: Array.isArray(to) ? to : [to],
+          subject,
+          html,
+          ...(text ? { text } : {}),
+          ...(process.env.MAIL_REPLY_TO ? { reply_to: process.env.MAIL_REPLY_TO } : {}),
+        }),
+        signal: AbortSignal.timeout(15000),
+      });
+    } catch (err) {
+      const erreur = new Error(`Resend injoignable : ${err.message}`);
+      erreur.code = err.name === 'TimeoutError' ? 'ETIMEDOUT' : 'ECONNECTION';
+      throw erreur;
+    }
+    const corps = await reponse.json().catch(() => ({}));
+    if (!reponse.ok) {
+      const erreur = new Error(`Resend ${reponse.status} : ${corps.message || corps.name || ''}`);
+      // 429 (quota) et 5xx sont passagers : traduits en 4xx « réessayez » façon SMTP ;
+      // les autres 4xx (clé, domaine non vérifié, adresse invalide) sont définitifs.
+      erreur.responseCode = reponse.status === 429 || reponse.status >= 500 ? 451 : 550;
+      throw erreur;
+    }
+    return { messageId: corps.id };
+  },
+};
+
+const transport = () => (resendConfigure() ? resendTransporter : transporter);
+
 const URL_PUBLIQUE = process.env.APP_PUBLIC_URL || '';
 
