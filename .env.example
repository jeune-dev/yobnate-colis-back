# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
LOG_LEVEL=info
# Adresse bind : 127.0.0.1 derrière un proxy Nginx, 0.0.0.0 en accès direct
HOST=0.0.0.0

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
DB_HOST=your_db_host_here
DB_PORT=your_db_port_here
DB_NAME=your_db_name_here
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
# En production avec un certificat TLS auto-signé (ex. Render, Railway) : mettre false
DB_SSL_REJECT_UNAUTHORIZED=true

# ─── JWT — OBLIGATOIRE : 2 secrets distincts, min 32 caractères aléatoires ───
# (la réinitialisation de mot de passe utilise un code OTP en base, pas de JWT dédié)
JWT_SECRET=changez_ce_secret_par_une_chaine_aleatoire_de_min_32_chars
JWT_REFRESH_SECRET=autre_secret_refresh_min_32_chars_different_du_jwt_secret
JWT_EXPIRES_IN=1h

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=

# ─── Cloudinary (upload images) ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Email — SMTP (nodemailer) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
MAIL_FROM=Yobnate Express <noreply@votre-domaine.com>

# ─── URL publique de l'application ────────────────────────────────────────────
# Utilisée pour construire les liens cliquables dans les emails (suivi, avis de
# passage, réinitialisation…). Laisser vide désactive simplement ces liens.
APP_PUBLIC_URL=https://votre-domaine.com

# ─── Super admin — OBLIGATOIRE pour npm run seed ──────────────────────────────
# CRIT-01 : aucun fallback hardcodé — SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD
# DOIVENT être définies pour que le compte super admin soit créé.
SUPER_ADMIN_EMAIL=admin@votre-domaine.com
SUPER_ADMIN_PASSWORD=VotreMotDePasse_Min12Chars!
SUPER_ADMIN_NOM=your_nom
SUPER_ADMIN_PRENOM=Yobnate

# ─── URL publique de l'API (lien de confirmation d'email cliquable) ───────────
# Vide = le lien pointe vers APP_PUBLIC_URL/verifier-email?token=… (l'application
# transmet alors le jeton à POST /auth/verify-email).
API_PUBLIC_URL=

# ─── Notifications push (Firebase Cloud Messaging, API HTTP v1) ───────────────
# Compte de service Firebase ; vide = push désactivé (notifications internes et emails conservés)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Activer aussi le paramètre « whatsapp_notifications_actives » dans /admin/parametres
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Modèle pré-approuvé (1 variable de corps) requis hors fenêtre de 24 h ; vide = texte libre
WHATSAPP_TEMPLATE_SUIVI=
WHATSAPP_TEMPLATE_LANGUE=fr
