# ============================================================
#  Yobante Colis API — variables d'environnement
#  Développement : copier en .env   ·   Production : copier en .env.prod
#  Aucun secret réel ne doit être commité.
# ============================================================

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# 127.0.0.1 derrière Nginx sur l'hôte (PM2) ; le conteneur Docker force 0.0.0.0
HOST=127.0.0.1
LOG_LEVEL=info
# Délai d'arrêt gracieux (ms)
SHUTDOWN_TIMEOUT_MS=10000
# Mode PM2 uniquement : nombre de workers (max = un par cœur)
PM2_INSTANCES=max

# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# Soit DATABASE_URL (prioritaire, fournie par Render et la plupart des hébergeurs),
# soit les variables DB_* ci-dessous (Docker, poste local).
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=yobante_colis
DB_USER=yobante
DB_PASSWORD=changez_moi
# TLS : true / false. Vide = TLS en production avec DATABASE_URL, sans TLS sinon
# (la base du docker-compose n'en a pas)
DB_SSL=
# Certificat de l'autorité (PEM ou base64) pour un certificat auto-signé
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true
# Pool de connexions PAR PROCESSUS. Avec PM2 en cluster : workers × DB_POOL_MAX doit
# rester sous max_connections de PostgreSQL (100 par défaut), marge comprise.
DB_POOL_MAX=10
DB_POOL_MIN=0
# Délai d'attente d'une connexion libre avant de répondre 503 (ms)
DB_POOL_ACQUIRE_MS=15000
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TX_TIMEOUT_MS=60000

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# Keep-alive supérieur à celui du proxy (Nginx : 60 s) pour éviter des 502
HTTP_KEEPALIVE_TIMEOUT_MS=65000
HTTP_REQUEST_TIMEOUT_MS=120000

# ─── Envois en arrière-plan (emails, push, WhatsApp) ─────────────────────────
# Concurrence et file PAR CANAL (email, push, WhatsApp : un canal en panne ne retient pas les autres)
ARRIERE_PLAN_CONCURRENCE=4
ARRIERE_PLAN_MAX=5000
SMTP_MAX_CONNEXIONS=3
# Tentatives d'envoi d'un email sur une panne passagère (maintenant, +2 s, +8 s)
SMTP_TENTATIVES=3

# ─── Protection du CPU et de la mémoire (par processus) ──────────────────────
# Hachages bcrypt simultanés (~250 ms de CPU chacun) : 1 sur un conteneur à 1 vCPU
BCRYPT_CONCURRENCE=2
# Réceptions de fichiers simultanées gardées en mémoire, puis attente maximale avant 503
UPLOAD_CONCURRENCE=4
UPLOAD_ATTENTE_MS=30000

# ─── Redis (facultatif) : compteurs partagés des limiteurs de débit ─────────
# Indispensable en cluster PM2 ; fourni automatiquement par docker-compose.prod.yml
REDIS_URL=

# ─── JWT — OBLIGATOIRE : 2 secrets DISTINCTS d'au moins 32 caractères ─────────
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h

# ─── CORS — OBLIGATOIRE en production : origines autorisées, séparées par des virgules
CORS_ORIGIN=http://localhost:5173

# ─── Limitation de débit (production) ────────────────────────────────────────
# Plafond global par COMPTE connecté (par IP pour les requêtes anonymes), sur 15 min
RATE_LIMIT_MAX=1000
# Inscription, mot de passe oublié, confirmation d'email : par IP, sur 15 min.
# Connexion : échecs seulement, par couple IP + identifiant
AUTH_RATE_LIMIT_MAX=10
# Échecs de connexion par IP, tous comptes confondus, sur 15 min
LOGIN_ECHECS_IP_MAX=50
# Suivi public par numéro, par IP, sur 15 min (freine l'énumération des numéros)
SUIVI_RATE_LIMIT_MAX=30

# ─── URLs publiques ──────────────────────────────────────────────────────────
# Liens des emails (suivi, paiement, réinitialisation). Vide = liens désactivés.
APP_PUBLIC_URL=
# Lien de confirmation d'email cliquable (vide = passe par APP_PUBLIC_URL)
API_PUBLIC_URL=

# ─── Cloudinary (photos, justificatifs, messages vocaux) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email — SMTP (nodemailer) ────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Yobante Colis <noreply@votre-domaine.com>

# ─── Notifications push (Firebase Cloud Messaging, API HTTP v1) ───────────────
# Vide = push désactivé (notifications internes et emails conservés)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Suivi des colis et codes de vérification du téléphone.
# Activer aussi « whatsapp_notifications_actives » dans /admin/parametres.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Modèle pré-approuvé (1 variable de corps) requis hors fenêtre de 24 h ; vide = texte libre
WHATSAPP_TEMPLATE_SUIVI=
WHATSAPP_TEMPLATE_LANGUE=fr

# ─── Sauvegardes (deploy/backup-postgres.sh) ──────────────────────────────────
# Clé de chiffrement des sauvegardes (vide = non chiffrées) — à conserver HORS du serveur
BACKUP_ENC_KEY=
BACKUP_DIR=/var/backups/yobante-colis
BACKUP_RETENTION_DAYS=14

# ─── Super administrateur — utilisé par npm run seed (aucune valeur par défaut)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NOM=Admin
SUPER_ADMIN_PRENOM=Yobante

# ─── Tests d'intégration : base JETABLE (nom terminé par _test, vidée à chaque run)
TEST_DB_NAME=
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_USER=
TEST_DB_PASSWORD=
# Parcours de bout en bout (tests/e2e) : base dédiée, ENTIÈREMENT vidée à chaque exécution
E2E_DATABASE_URL=
